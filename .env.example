# Lokale Konfiguration der Kita-App. Kopie als ".env" anlegen und Werte anpassen.
# Die Datei .env ist per .gitignore ausgeschlossen und darf nie eingecheckt werden.

# Datenbank (MySQL/MariaDB)
DB_HOST=localhost
DB_NAME=kita_demo
DB_USER=example_user
DB_PASSWORD=CHANGE_ME

# URLs der Anwendung. Das Frontend ruft den Server-Teil (app_srv/) per HTTP auf.
APP_NAME=kita-app
APP_CLIENT_URL=http://localhost:8000/
APP_SERVER_URL=http://localhost:8000/app_srv/

# Telefonnummern (nur Anzeige/Benachrichtigung, Beispielwerte)
APP_PHONE=+49000000000
ADMIN_PHONE=+49000000000

# Komma-getrennte lin_index-Werte der Logins, die Admin-Mails erhalten
ADMIN_USER_IDS=1

# SMTP fuer Passwort-Reset und Benachrichtigungen (leer lassen = kein Versand moeglich)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@example.com

# Shared Secret, mit dem sich ein externer Signal-Bot an app_srv/signal.php anmeldet
SIGNAL_API_KEY=CHANGE_ME
